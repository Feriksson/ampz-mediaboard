<Application x:Class="AmpzMediaBoard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- ══ Paleta ══
             Oscura, y no por moda: un board de referencia se mira POR EL VIDEO. Cualquier gris
             claro alrededor del clip te falsea la percepción del color y del contraste de lo que
             estás mirando. El acento es lo único saturado, y se reserva para lo interactivo
             (selección, markers de loop). -->
        <SolidColorBrush x:Key="WindowBrush"      Color="#14141A" />
        <SolidColorBrush x:Key="SectorBrush"      Color="#1B1B22" />
        <SolidColorBrush x:Key="HeaderBrush"      Color="#24242E" />
        <SolidColorBrush x:Key="SplitterBrush"    Color="#2E2E3A" />
        <SolidColorBrush x:Key="AccentBrush"      Color="#4CC2FF" />
        <SolidColorBrush x:Key="TextBrush"        Color="#E6E6EC" />
        <SolidColorBrush x:Key="DimTextBrush"     Color="#8A8A99" />
        <SolidColorBrush x:Key="HintBrush"        Color="#5A5A6B" />
        <SolidColorBrush x:Key="HintBorderBrush"  Color="#33333F" />
        <SolidColorBrush x:Key="TrackBrush"       Color="#33333F" />
        <SolidColorBrush x:Key="LoopBrush"        Color="#4CC2FF" Opacity="0.45" />
        <SolidColorBrush x:Key="PlayheadBrush"    Color="#FFFFFF" />
        <SolidColorBrush x:Key="DropVeilBrush"    Color="#4CC2FF" Opacity="0.20" />

        <!-- Ámbar y no rojo: un archivo que falta NO es un error de la app, es un estado que se
             puede resolver (re-vincular). El rojo se reserva para lo que de verdad se rompió. -->
        <SolidColorBrush x:Key="WarnBrush"        Color="#FFB454" />
        <SolidColorBrush x:Key="WarnBorderBrush"  Color="#6B5327" />
        <SolidColorBrush x:Key="WarnFillBrush"    Color="#FFB454" Opacity="0.07" />

        <!-- ══ Botón de ícono de la cabecera del sector ══ -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A48" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Botón de transporte (play / pause) ══ -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#2E2E3A" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3D3D4C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Toggle de la zona de loop ══
             Apagado se lee como un botón muerto; encendido se pinta con el acento, el MISMO
             color que los markers de la timeline. Eso no es capricho: enlaza visualmente el
             botón con lo que controla, sin necesidad de leer nada. -->
        <Style x:Key="LoopToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="#2E2E3A" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#0E1620" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Toggle de silencio del sector ══
             Los glifos salen de Segoe MDL2 Assets (viene con Windows 10/11): E767 = altavoz,
             E74F = altavoz tachado. Se usa una fuente de íconos del sistema y no un emoji
             porque el emoji lo renderiza a color y de tamaño impredecible según la fuente
             que le toque, y acá queremos un ícono monocromo que siga al Foreground. -->
        <Style x:Key="MuteToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="24" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Content" Value="&#xE767;" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="#2E2E3A" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="&#xE74F;" />
                                <!-- Silenciado se pinta ámbar, no rojo: no es un error, es un
                                     estado que elegiste. Mismo criterio que el archivo ausente. -->
                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3D3D4C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Slider de volumen ══
             Template propio y mínimo: el Slider por defecto de WPF trae marcas, un thumb
             gigante y colores claros que no pegan ni un poco con el board oscuro. -->
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource TrackBrush}" />
                            <!-- PART_SelectionRange pinta el tramo lleno; Slider lo maneja solo
                                 con IsSelectionRangeEnabled. Acá se resuelve con un Track normal
                                 y el relleno queda implícito en la posición del thumb: menos
                                 piezas y alcanza para leer el nivel de un vistazo. -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{StaticResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="11" Height="11">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource TextBrush}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Con el sector silenciado el slider se apaga: mover un volumen
                                 que no suena es la clase de control que te hace dudar de si la
                                 app funciona. -->
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Botón de la barra superior ══ -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#2A2A34" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
