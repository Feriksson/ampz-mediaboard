<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Prueba de REGRESION del reinicio del loop al terminar el clip.

    Cubre el bug de "movi el video de celda y al terminar vuelve a arrancar en cualquier lado,
    sin respetar el marker A". Causa: la opcion :start-time vive en el objeto Media, y un
    Play() sin media nuevo la vuelve a aplicar. Ver SectorNode.RestartFrom.

    A diferencia de BoardProbe, esta SI toca VLC de verdad: abre un clip real y lo deja llegar
    al final. Necesita el clip que genera el script de al lado. Sale 0 si pasa, 1 si fallo.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RestartProbe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AmpzMediaBoard.csproj" />
  </ItemGroup>

</Project>
