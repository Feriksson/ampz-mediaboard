<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test de regresion del playhead de la timeline. Ver el README de tools/ para como correrlo
    (un comentario XML no puede contener dos guiones seguidos, asi que el comando no va aca).
    Sale con codigo 0 si el binding del playhead sobrevive al click en el riel, y con 1 si
    volvio el bug de la marca congelada.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>LoopProbe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referencia al proyecto REAL: se prueba la clase LoopTimeline de produccion, no una maqueta. -->
    <ProjectReference Include="..\..\AmpzMediaBoard.csproj" />
  </ItemGroup>

</Project>
