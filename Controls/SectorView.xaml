<UserControl x:Class="AmpzMediaBoard.Controls.SectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:media="clr-namespace:AmpzMediaBoard.Media"
             xmlns:ctl="clr-namespace:AmpzMediaBoard.Controls"
             AllowDrop="True">

    <Border x:Name="Frame" BorderThickness="2" CornerRadius="6" Margin="3"
            Background="{DynamicResource SectorBrush}" BorderBrush="Transparent">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- El sector seleccionado es el que reciben los atajos y los botones de
                         partir. Sin una marca visual clara, partís el sector equivocado. -->
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ══ Cabecera ══
                 Además de mostrar el nombre y los botones, es un DROP TARGET garantizado:
                 el video se dibuja en una ventana hosteada (HWND) que puede tragarse los eventos
                 de drop, pero la cabecera es WPF puro y siempre los recibe. Si algún día el drop
                 sobre el video falla, esta barra sigue funcionando. -->
            <Border x:Name="Header" Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                    CornerRadius="4,4,0,0" Padding="6,3">
                <Grid>
                    <!-- La cabecera es tambien el ASA DE ARRASTRE para mover el media a otro
                         sector. Se eligio la cabecera y no el area de video porque esa area es
                         un HWND hosteado: arrastrar desde ahi es poco confiable. Ademas evita
                         que un click cualquiera sobre el video se interprete como arrastre. -->
                    <!-- El margen deja lugar a los SEIS botones de la derecha (22px cada uno). -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,142,0">
                        <!-- Asa visible. Sin una pista de que la cabecera se arrastra, la
                             funcionalidad existe pero nadie la encuentra: una feature invisible
                             es una feature que no está. Solo aparece con media cargado, porque
                             un sector vacío no tiene nada que mover. -->
                        <TextBlock x:Name="DragGrip" Text="&#x22EE;&#x22EE;" FontSize="12" Margin="0,0,5,0"
                                   VerticalAlignment="Center" Visibility="Collapsed"
                                   Foreground="{DynamicResource HintBrush}"
                                   ToolTip="Arrastrá de acá para mover el media a otro sector" />
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}"
                                   FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Elegir el archivo sin arrastrar. Va PRIMERO porque es la acción de
                             "traer contenido": el resto de los botones operan sobre lo que ya
                             hay. En el diálogo se puede pegar un path completo y dar Enter. -->
                        <!-- ⚠ Acá había un glifo de carpeta de "Segoe MDL2 Assets" y salía TOFU
                             (el rectángulo vacío del glifo faltante) — verificado con captura y
                             zoom. La fuente carga (el botón de silencio la usa y anda), pero ese
                             codepoint no está. Los puntos suspensivos son LA convención de
                             Windows para "buscar un archivo" y existen en cualquier fuente: no
                             pueden fallar. Con íconos, lo aburrido y garantizado le gana a lo
                             lindo y frágil. -->
                        <Button x:Name="BrowseButton" Content="&#x2026;" FontSize="13" FontWeight="Bold"
                                ToolTip="Elegir el archivo…  (o pegá el path con Ctrl+V sobre el sector)"
                                Style="{DynamicResource IconButton}" />
                        <Button x:Name="SplitVerticalButton" Content="&#x2502;" ToolTip="Partir en dos columnas"
                                Style="{DynamicResource IconButton}" />
                        <Button x:Name="SplitHorizontalButton" Content="&#x2500;" ToolTip="Partir en dos filas"
                                Style="{DynamicResource IconButton}" />
                        <!-- Copiar el path del archivo al portapapeles. Es el camino de VUELTA del
                             Ctrl+V que ya existe: el sector sabe qué archivo tiene y de dónde salió;
                             sacar esa ruta a mano obliga a ir al Explorer a buscarla de nuevo.
                             ⚠ El glifo ⧉ (U+29C9) se VERIFICO contra "Segoe UI Symbol" con
                             GlyphTypeface antes de ponerlo — en "Segoe UI" NO existe y saldria
                             TOFU, que es exactamente el error que ya se pago con el de carpeta. -->
                        <Button x:Name="CopyPathButton" Content="&#x29C9;" FontFamily="Segoe UI Symbol"
                                ToolTip="Copiar el path del archivo al portapapeles"
                                Style="{DynamicResource IconButton}" />
                        <!-- Desvincular el media. El glifo era ↺ y se leia como "recargar" o
                             "deshacer"; ⏏ (expulsar) dice lo que hace sin tener que leer nada. -->
                        <Button x:Name="ClearButton" Content="&#x23CF;" FontFamily="Segoe UI Symbol"
                                ToolTip="Desvincular el media (el sector queda vacío)"
                                Style="{DynamicResource IconButton}" />
                        <Button x:Name="CloseButton" Content="&#x2715;" ToolTip="Cerrar el sector"
                                Style="{DynamicResource IconButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Área de media ══ -->
            <Grid Grid.Row="1" Background="Black">
                <vlc:VideoView x:Name="Video" Visibility="Collapsed" />

                <Image x:Name="Still" Stretch="Uniform" Visibility="Collapsed"
                       Source="{Binding ImageSource}" />

                <!-- Estado vacío: no es decoración, es la única pista de CÓMO se usa la app. -->
                <Border x:Name="EmptyHint" BorderThickness="1.5" CornerRadius="4" Margin="10"
                        BorderBrush="{DynamicResource HintBorderBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#x2B07;" FontSize="26" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource HintBrush}" />
                        <TextBlock Text="Arrastrá un video o una imagen" Margin="0,6,0,0"
                                   Foreground="{DynamicResource HintBrush}" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Archivo ausente: el board recuerda qué iba acá, pero el archivo no está.
                     Se muestra el nombre Y el path completo a propósito — sin el path no sabés
                     si el clip se borró o si simplemente el disco externo no está conectado. -->
                <Border x:Name="MissingHint" Visibility="Collapsed" BorderThickness="1.5" CornerRadius="4"
                        Margin="10" BorderBrush="{DynamicResource WarnBorderBrush}"
                        Background="{DynamicResource WarnFillBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                        <TextBlock Text="&#x26A0;" FontSize="22" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource WarnBrush}" />
                        <TextBlock Text="No se encontró el archivo" Margin="0,4,0,0" FontSize="12"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="MissingName" Margin="0,6,0,0" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource WarnBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        <TextBlock x:Name="MissingFullPath" Margin="0,2,0,0" FontSize="9"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource HintBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="340" />
                        <Button x:Name="RelinkButton" Content="Buscar el archivo…" Margin="0,12,0,0"
                                HorizontalAlignment="Center" Style="{DynamicResource ToolbarButton}" />
                        <TextBlock Text="o arrastrá otro encima para reemplazarlo" Margin="0,8,0,0" FontSize="10"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource HintBrush}" />
                        <TextBlock Text="Tus markers de loop se conservan" Margin="0,2,0,0" FontSize="9"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource HintBrush}"
                                   FontStyle="Italic" />
                    </StackPanel>
                </Border>

                <!-- Velo de arrastre: se prende cuando hay un archivo válido encima.
                     ⚠ IsHitTestVisible=False es OBLIGATORIO. Si el velo participa del hit-test,
                     al aparecer se convierte ÉL MISMO en el elemento bajo el cursor → se dispara
                     DragLeave → el velo se apaga → el DragOver siguiente lo vuelve a prender.
                     Ese ciclo es el parpadeo. -->
                <!-- Velo de CONGELADO: se prende mientras el usuario arrastra un divisor.
                     Durante el arrastre el VideoView se colapsa (su ventana nativa sale del
                     layout) y el clip se pausa; sin este cartel el sector quedaría en negro y
                     parecería que se rompió. Ver SectorView.SetFrozen y SectorNode.Freeze.
                     IsHitTestVisible=False para no interferir con el arrastre del splitter. -->
                <Border x:Name="FreezeVeil" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="#12121A">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#x2921;" FontFamily="Segoe UI Symbol" FontSize="22"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource HintBrush}" />
                        <TextBlock Text="Redimensionando…" Margin="0,6,0,0" FontSize="11"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource HintBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="DropVeil" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="{DynamicResource DropVeilBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="4">
                    <!-- El texto lo pone OnDragOver: cambia según lo que estés arrastrando
                         (un archivo nuevo, o media de otro sector que va a intercambiarse). -->
                    <TextBlock x:Name="DropVeilText" Text="Soltá acá" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" />
                </Border>
            </Grid>

            <!-- ══ Transporte + zona de loop ══
                 Solo aparece con video cargado: una imagen no tiene nada que reproducir. -->
            <Grid x:Name="Transport" Grid.Row="2" Margin="6,4,6,6">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static media:MediaKind.Video}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <!-- El estilo va como elemento (y no como atributo Style=) porque necesita un
                         DataTrigger propio para alternar el glifo ▶/⏸ según IsPlaying. -->
                    <Button x:Name="PlayButton" Width="34">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TransportButton}">
                                <Setter Property="Content" Value="&#x25B6;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="&#x23F8;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <ToggleButton x:Name="LoopButton" Content="LOOP" Margin="6,0,0,0"
                                  IsChecked="{Binding LoopEnabled, Mode=TwoWay}"
                                  Style="{DynamicResource LoopToggle}"
                                  ToolTip="Reproducir solo dentro de la zona marcada" />

                    <!-- ══ Audio del sector ══
                         El mute va SEPARADO del volumen (y no es "volumen a 0") para que
                         silenciar y volver no te haga perder el nivel que ajustaste. En un board
                         con varios clips corriendo, mutear es la acción más frecuente de las dos:
                         por eso es un botón de un click y no un arrastre al extremo del slider. -->
                    <ToggleButton x:Name="MuteButton" Margin="6,0,0,0" Width="30"
                                  IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                  Style="{DynamicResource MuteToggle}"
                                  ToolTip="Silenciar este sector" />
                    <Slider x:Name="VolumeSlider" Width="66" Margin="4,0,0,0" VerticalAlignment="Center"
                            Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                            Value="{Binding Volume, Mode=TwoWay}"
                            Style="{DynamicResource VolumeSlider}"
                            ToolTip="Volumen de este sector" />

                    <TextBlock x:Name="TimeLabel" VerticalAlignment="Center" Margin="10,0,0,0"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource DimTextBrush}" />
                </StackPanel>

                <ctl:LoopTimeline x:Name="Timeline" Grid.Row="1" Margin="0,2,0,0"
                                  DurationMs="{Binding DurationMs, Mode=OneWay}"
                                  PositionMs="{Binding PositionMs, Mode=OneWay}"
                                  LoopStartMs="{Binding LoopStartMs, Mode=TwoWay}"
                                  LoopEndMs="{Binding LoopEndMs, Mode=TwoWay}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
