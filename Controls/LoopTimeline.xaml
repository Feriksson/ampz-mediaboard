<UserControl x:Class="AmpzMediaBoard.Controls.LoopTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="30" Background="Transparent" ClipToBounds="True">

    <UserControl.Resources>
        <!-- Los markers son Thumb pelados: nos interesa SOLO su lógica de arrastre, no su
             apariencia por defecto (que es un botón gris de Windows 95). Template propio. -->
        <Style x:Key="MarkerThumb" TargetType="Thumb">
            <Setter Property="Width" Value="11" />
            <Setter Property="Cursor" Value="SizeWE" />
            <!-- El ajuste fino con Shift es invisible si no se avisa: un modificador que nadie
                 sabe que existe, no existe. Ver LoopTimeline.FineMsPerPixel. -->
            <Setter Property="ToolTip" Value="Arrastrá para mover el marker.&#x0a;Con Shift, ajuste fino (el riel entero mide el clip entero: en un clip largo, un píxel son segundos).&#x0a;Las teclas A y B lo fijan exacto donde está el playhead." />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <!-- El Grid transparente ENSANCHA el área de agarre más allá de la
                             barrita visible: agarrar 3px con el mouse es una tortura. -->
                        <Grid Background="Transparent">
                            <Rectangle Width="3" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5" />
                            <!-- Cabecita superior: da un blanco visual mucho más grande para el ojo. -->
                            <Border Width="9" Height="9" VerticalAlignment="Top"
                                    CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas x:Name="Root" Background="Transparent">
        <!-- Riel de fondo: el clip completo. -->
        <Border x:Name="Track" Height="10" Canvas.Top="14"
                CornerRadius="5" Background="{DynamicResource TrackBrush}" />

        <!-- Zona de loop: el tramo entre los markers A y B. -->
        <Border x:Name="LoopRegion" Height="10" Canvas.Top="14"
                CornerRadius="5" Background="{DynamicResource LoopBrush}" />

        <!-- Playhead: dónde está reproduciendo AHORA. IsHitTestVisible=False porque si intercepta
             el mouse, no podés hacer click para buscar justo donde está el playhead. -->
        <Rectangle x:Name="Playhead" Width="2" Height="22" Canvas.Top="8"
                   Fill="{DynamicResource PlayheadBrush}" IsHitTestVisible="False" />

        <Thumb x:Name="ThumbA" Style="{StaticResource MarkerThumb}" Height="28" Canvas.Top="1" />
        <Thumb x:Name="ThumbB" Style="{StaticResource MarkerThumb}" Height="28" Canvas.Top="1" />
    </Canvas>
</UserControl>
